// Fowl Play: shooting ducks over a marsh, the way it was done on a console of
// the eighties with a light gun —here the mouse is the gun, or a game
// controller's stick and A, or a finger on a tablet—. Game A sends one duck at
// a time, game B two, game C throws clays. Ten to a round, three shots each
// time; hit too few of the ten and the round is the last.
//
// Everything is drawn at the console's 256 × 240 and made bigger, a whole
// number of times when the window allows it. The pictures are pixel art
// (`pixels`), which stays sharp however much the group scales it.
// `./play.sh`, or `pleamar --no-hud --scene fowl.plm` (pleamar 0.4.14 or newer).
language 0.4
scene Fowl {
    surface { size: 768, 720; kind: window; title: "Fowl Play"; rate: 60; keyboard: on_demand }
    permissions { services: "sound", "gamepad", "files", "files.write" }

    font file "fonts/PressStart2P-Regular.ttf"
    // The sheets: the dog (13 pictures), the ducks (16 pictures —eight facing
    // right, their mirrors— in a row for each of the three kinds), the
    // board's small pieces, the clays from near to far and broken, the sight.
    image dog = pixels "pieces/dog.png", 754, 50
    image ducks = pixels "pieces/ducks.png", 544, 102
    image hud = pixels "pieces/hud.png", 50, 10
    image clay = pixels "pieces/clay.png", 180, 12
    image sight = pixels "pieces/sight.png", 17, 17
    image marsh = pixels "pieces/marsh.png", 256, 240
    image range = pixels "pieces/range.png", 256, 240

    let ink = #fcfcfc
    let night = #000000
    let sky = #3cbcfc
    let pink = #fcbcb0
    let grass = #80d010
    let orange = #fca044
    let rust = #e45c10
    let blue = #0058f8

    // ── what the logic says ──
    fact screen: number = 0          // 0 the title, 1 the marsh (games A and B), 2 the clay range (C)
    fact pink_sky = false            // a duck is getting away
    fact flash: number = 0           // the gun: 1 the screen all black, 2 the white boxes where the targets are
    fact paused = false
    fact choice: number = 0          // the title's line: game A, B or C
    fact dog.x: number = -60
    fact dog.y: number = 137
    fact dog.cell: number = 0
    fact dog.show = false
    fact dog.front = true            // over the grass (walking, leaping), or behind it (rising out of it)
    fact shells: number = 3
    fact quota: number = 6           // hits the round asks for: as many blue bars under the board's ducks
    fact banner: number = 0          // 0 none, or how many lines of the texts below a black box says
    fact sight.on = false            // a game controller is aiming: the sight is drawn
    fact sight.x: number = 128
    fact sight.y: number = 100
    fact board.clay = false

    text round_t = "R=1"
    text score_t = "000000"
    text top_t = "TOP SCORE = 12000"
    text line1 = ""
    text line2 = ""
    text hint_t = ""

    model ducks max 2 { x: number; y: number; cell: number; show: bool }
    model clays max 2 { x: number; y: number; cell: number; show: bool }
    model held max 2 { x: number; y: number; cell: number }
    model pops max 2 { x: number; y: number; label: text }
    model marks max 10 { cell: number; lit: bool = true }
    model boxes max 2 { x: number; y: number; w: number; h: number }

    // The gun: where it is pressed, in the console's pixels.
    event aimx ->
    event aimy ->

    // Drawn for 256 × 240, made bigger a whole number of times when it fits.
    let fit = min(screen.width / 256, screen.height / 240)
    let k = if(fit >= 2, floor(fit), fit)
    let ox = floor((screen.width - 256 * k) / 2)
    let oy = floor((screen.height - 240 * k) / 2)

    box { from: 0, 0; size: screen.width, screen.height; color: night }

    group {
        pivot: 0, 0
        scale: k
        move: ox, oy
        clip box { from: 0, 0; size: 256, 240 }

        // ── the marsh: games A and B ──
        group {
            show: screen == 1
            box { from: 0, 0; size: 256, 240; color: if(pink_sky, pink, sky) }
            // The ducks fly behind the tree and come up out of the grass.
            for d in ducks {
                image ducks { at: d.x - 1, d.y - 1; size: 34, 34; cell: d.cell, 16, 3; show: d.show }
            }
            // Rising out of the grass, holding what it found, or laughing.
            image dog { at: dog.x - 1, dog.y - 1; size: 58, 50; cell: dog.cell, 13; show: dog.show and not dog.front }
            // What it holds, hanging by its feet from its paws.
            for h in held {
                image ducks { at: h.x - 1, h.y - 1; size: 34, 34; cell: h.cell, 16, 3 }
            }
            image marsh { at: 0, 0; size: 256, 240 }
            // Walking in front of the grass, and leaping into it.
            image dog { at: dog.x - 1, dog.y - 1; size: 58, 50; cell: dog.cell, 13; show: dog.show and dog.front }
        }

        // ── the clay range: game C ──
        group {
            show: screen == 2
            box { from: 0, 0; size: 256, 240; color: sky }
            image range { at: 0, 0; size: 256, 240 }
            for c in clays {
                image clay { at: c.x - 9, c.y - 6; size: 18, 12; cell: c.cell, 10; show: c.show }
            }
        }

        // What a hit is worth, where it was hit.
        for p in pops {
            text p.label { at: p.x, p.y; anchor: center; size: 8; family: "Press Start 2P"; color: ink }
        }

        // ── the board, on the dirt ──
        group {
            show: screen != 0
            box { from: 22, 190; size: 28, 10; color: night; corner: 2 }
            text round_t { at: 24, 191; anchor: left top; size: 8; family: "Press Start 2P"; color: grass }
            box { from: 22, 202; size: 36, 22; color: night; corner: 3 }
            repeat n in 0..3 {
                image hud { at: 26 + n * 10, 204; size: 10, 10; cell: 4, 5; show: n < shells }
            }
            text "SHOT" { at: 24, 214; anchor: left top; size: 8; family: "Press Start 2P"; color: sky }

            box { from: 64, 202; size: 128, 22; color: night; corner: 3 }
            text "HIT" { at: 67, 207; anchor: left top; size: 8; family: "Press Start 2P"; color: grass }
            for m in marks {
                image hud { at: 92 + m.index * 9, 203; size: 10, 10; cell: m.cell, 5; show: m.lit }
            }
            repeat n in 0..10 {
                box { from: 93 + n * 9, 214; size: 7, 2; color: blue; show: n < quota }
            }

            box { from: 196, 202; size: 54, 22; color: night; corner: 3 }
            text score_t { at: 199, 204; anchor: left top; size: 8; family: "Press Start 2P"; color: ink }
            text "SCORE" { at: 203, 214; anchor: left top; size: 8; family: "Press Start 2P"; color: ink }
        }

        // ── what is said in a box: the round, a duck getting away, the end ──
        group {
            show: banner > 0 and screen != 0
            box { from: 76, 54; size: 104, if(banner == 1, 22, 34); color: ink }
            box { from: 77, 55; size: 102, if(banner == 1, 20, 32); color: night }
            text line1 { at: 128, 61; anchor: center top; size: 8; family: "Press Start 2P"; color: ink }
            text line2 { at: 128, 75; anchor: center top; size: 8; family: "Press Start 2P"; color: ink }
        }

        // ── the title ──
        group {
            show: screen == 0
            box { from: 0, 0; size: 256, 240; color: night }
            text "FOWL" { at: 129, 33; anchor: center top; size: 32; family: "Press Start 2P"; color: rust }
            text "FOWL" { at: 128, 32; anchor: center top; size: 32; family: "Press Start 2P"; color: sky }
            text "PLAY" { at: 129, 71; anchor: center top; size: 32; family: "Press Start 2P"; color: rust }
            text "PLAY" { at: 128, 70; anchor: center top; size: 32; family: "Press Start 2P"; color: sky }
            text "GAME A   1 DUCK" { at: 56, 124; anchor: left top; size: 8; family: "Press Start 2P"; color: orange }
            text "GAME B   2 DUCKS" { at: 56, 140; anchor: left top; size: 8; family: "Press Start 2P"; color: orange }
            text "GAME C   CLAY SHOOTING" { at: 56, 156; anchor: left top; size: 8; family: "Press Start 2P"; color: orange }
            image hud { at: 41, 123 + choice * 16; size: 10, 10; cell: 0, 5 }
            text top_t { at: 128, 180; anchor: center top; size: 8; family: "Press Start 2P"; color: grass }
            text hint_t { at: 128, 206; anchor: center top; size: 8; family: "Press Start 2P"; color: #7c7c7c }
            text "A PLEAMAR FAN GAME" { at: 128, 222; anchor: center top; size: 8; family: "Press Start 2P"; color: #7c7c7c }
            zone box pick_a { from: 36, 118; size: 200, 16; cursor: pointer }
            zone box pick_b { from: 36, 134; size: 200, 16; cursor: pointer }
            zone box pick_c { from: 36, 150; size: 200, 16; cursor: pointer }
        }

        // A controller aims with a sight of its own.
        image sight { at: sight.x - 8, sight.y - 8; size: 17, 17; show: sight.on and screen != 0 and flash == 0 }

        // Paused: the field is kept as it is, behind a word.
        group {
            show: paused
            box { from: 0, 0; size: 256, 240; color: night; opacity: 0.55 }
            box { from: 88, 96; size: 80, 22; color: ink }
            box { from: 89, 97; size: 78, 20; color: night }
            text "PAUSE" { at: 128, 103; anchor: center top; size: 8; family: "Press Start 2P"; color: ink }
            text "Q  TO THE TITLE" { at: 128, 128; anchor: center top; size: 8; family: "Press Start 2P"; color: ink }
        }

        // The gun: as the console did, a frame of black, then the targets in white.
        box { from: 0, 0; size: 256, 240; color: night; show: flash > 0 }
        for b in boxes {
            box { from: b.x, b.y; size: b.w, b.h; color: ink; show: flash == 2 }
        }

        // Where the gun is pointed: everywhere but the title's lines.
        zone box gun { from: 0, 0; size: 256, 240; cursor: crosshair; show: screen != 0 }
    }

    on press gun { emit aimx(local.x); emit aimy(local.y) }
    on press pick_a { emit aimx(-1); emit aimy(0) }
    on press pick_b { emit aimx(-1); emit aimy(1) }
    on press pick_c { emit aimx(-1); emit aimy(2) }
}
